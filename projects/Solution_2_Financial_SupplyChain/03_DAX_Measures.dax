// =============================================================================
// SOLUTION 2: FINANCIAL P&L + SUPPLY CHAIN — DAX MEASURES LIBRARY
// Tables: fact_GL_Entries, fact_SalesOrders, fact_Inventory, fact_PurchaseOrders
//         dim_Accounts, dim_CostCenters, dim_Products, dim_Suppliers, dim_Date
// Author: Madhura Pal | Portfolio Project
// =============================================================================


// ── TABLE: _Finance Measures | _SupplyChain Measures (keep in separate groups)


// =============================================================================
// SECTION 1: REVENUE & GROSS PROFIT (P&L Top)
// =============================================================================

Total Revenue =
// All revenue lines, Actuals only
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[account_type] = "Revenue",
    fact_GL_Entries[scenario]  = "Actual"
)

Total Revenue (Budget) =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[account_type] = "Revenue",
    fact_GL_Entries[scenario]  = "Budget"
)

Revenue Variance =
[Total Revenue] - [Total Revenue (Budget)]

Revenue Variance % =
DIVIDE([Revenue Variance], ABS([Total Revenue (Budget)]), 0)

Total COGS =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[account_type] = "COGS",
    fact_GL_Entries[scenario]  = "Actual"
)

Total COGS (Budget) =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[account_type] = "COGS",
    fact_GL_Entries[scenario]  = "Budget"
)

Gross Profit =
[Total Revenue] - [Total COGS]

Gross Profit (Budget) =
[Total Revenue (Budget)] - [Total COGS (Budget)]

Gross Margin % =
DIVIDE([Gross Profit], [Total Revenue], 0)

Gross Margin % (Budget) =
DIVIDE([Gross Profit (Budget)], [Total Revenue (Budget)], 0)

Gross Margin Variance bps =
// Basis points variance (useful for finance reporting)
([Gross Margin %] - [Gross Margin % (Budget)]) * 10000


// =============================================================================
// SECTION 2: OPEX & EBITDA
// =============================================================================

Total OpEx =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[account_type] = "OpEx",
    dim_Accounts[pl_category]  = "EBITDA",
    fact_GL_Entries[scenario]  = "Actual"
)

Total OpEx (Budget) =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[account_type] = "OpEx",
    dim_Accounts[pl_category]  = "EBITDA",
    fact_GL_Entries[scenario]  = "Budget"
)

EBITDA =
[Gross Profit] - [Total OpEx]

EBITDA (Budget) =
[Gross Profit (Budget)] - [Total OpEx (Budget)]

EBITDA Margin % =
DIVIDE([EBITDA], [Total Revenue], 0)

EBITDA Variance =
[EBITDA] - [EBITDA (Budget)]

EBITDA Variance % =
DIVIDE([EBITDA Variance], ABS([EBITDA (Budget)]), 0)

OpEx Variance =
[Total OpEx] - [Total OpEx (Budget)]

OpEx Variance Flag =
// Negative = favorable for costs (spent less than planned)
IF([OpEx Variance] <= 0, "Favorable", "Unfavorable")


// =============================================================================
// SECTION 3: NET INCOME (BELOW EBITDA)
// =============================================================================

DA Expense =
// Depreciation & Amortisation
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[pl_category] = "Net Income",
    dim_Accounts[pl_line]     = "D&A",
    fact_GL_Entries[scenario] = "Actual"
)

EBIT =
[EBITDA] - [DA Expense]

Interest Expense =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[pl_line] = "Interest",
    fact_GL_Entries[scenario] = "Actual"
)

EBT =
[EBIT] - [Interest Expense]

Tax Expense =
CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    dim_Accounts[pl_line] = "Tax",
    fact_GL_Entries[scenario] = "Actual"
)

Net Income =
[EBT] - [Tax Expense]

Net Income Margin % =
DIVIDE([Net Income], [Total Revenue], 0)


// =============================================================================
// SECTION 4: VARIANCE ANALYSIS (BRIDGE / WATERFALL)
// =============================================================================

Variance Abs =
// Generic variance: actual - budget (positive = over for revenue, over budget for costs)
[Total Revenue] - [Total Revenue (Budget)]

Favorable Variance Flag =
// Context-sensitive: revenue positive is good; cost positive is bad
VAR _acct_type = SELECTEDVALUE(dim_Accounts[account_type])
VAR _var       = [Variance Abs]
RETURN
    IF(_acct_type = "Revenue",
        IF(_var >= 0, "Favorable ▲", "Unfavorable ▼"),
        IF(_var <= 0, "Favorable ▼", "Unfavorable ▲")
    )

Budget Attainment % =
// % of budget achieved (100% = on target)
DIVIDE([Total Revenue], [Total Revenue (Budget)], 0)

YoY Revenue Growth =
[Total Revenue] - CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_Date[Date]))

YoY Revenue Growth % =
DIVIDE(
    [YoY Revenue Growth],
    ABS(CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_Date[Date]))),
    0
)

QoQ Revenue Growth % =
DIVIDE(
    [Total Revenue] - CALCULATE([Total Revenue], DATEADD(dim_Date[Date], -1, QUARTER)),
    ABS(CALCULATE([Total Revenue], DATEADD(dim_Date[Date], -1, QUARTER))),
    0
)

Revenue YTD =
CALCULATE([Total Revenue], DATESYTD(dim_Date[Date]))

Revenue PYTD =
CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(DATESYTD(dim_Date[Date])))

Revenue YTD vs PYTD % =
DIVIDE([Revenue YTD] - [Revenue PYTD], ABS([Revenue PYTD]), 0)


// =============================================================================
// SECTION 5: SUPPLY CHAIN — OTIF & ORDER PERFORMANCE
// =============================================================================

Total Orders =
COUNTROWS(fact_SalesOrders)

OTIF Count =
CALCULATE(COUNTROWS(fact_SalesOrders), fact_SalesOrders[is_otif] = TRUE())

OTIF Rate % =
// On Time In Full — primary supply chain KPI; target typically 95%+
DIVIDE([OTIF Count], [Total Orders], 0)

On Time Rate % =
DIVIDE(
    CALCULATE(COUNTROWS(fact_SalesOrders), fact_SalesOrders[is_on_time] = TRUE()),
    [Total Orders],
    0
)

In Full Rate % =
DIVIDE(
    CALCULATE(COUNTROWS(fact_SalesOrders), fact_SalesOrders[is_in_full] = TRUE()),
    [Total Orders],
    0
)

OTIF vs Target =
// RAG status vs 95% target
VAR _rate = [OTIF Rate %]
RETURN
    IF(_rate >= 0.95, "Green",
    IF(_rate >= 0.90, "Amber",
    "Red"))

Avg Days Late =
AVERAGEX(
    FILTER(fact_SalesOrders, NOT ISBLANK(fact_SalesOrders[days_late])),
    fact_SalesOrders[days_late]
)

Total Returns Value =
SUM(fact_SalesOrders[return_amount])

Return Rate % =
DIVIDE(
    SUM(fact_SalesOrders[return_qty]),
    SUM(fact_SalesOrders[quantity]),
    0
)

Net Revenue (Sales) =
SUM(fact_SalesOrders[net_revenue])

Gross Profit (Sales) =
SUM(fact_SalesOrders[gross_profit])

Gross Margin % (Sales) =
DIVIDE([Gross Profit (Sales)], [Net Revenue (Sales)], 0)

Avg Discount % =
AVERAGEX(
    fact_SalesOrders,
    DIVIDE(fact_SalesOrders[discount_amount], fact_SalesOrders[gross_revenue], 0)
)


// =============================================================================
// SECTION 6: INVENTORY KPIs
// =============================================================================

Total Inventory Value =
SUM(fact_Inventory[inventory_value])

Stockout Count =
CALCULATE(
    COUNTROWS(fact_Inventory),
    fact_Inventory[stockout_flag] = TRUE()
)

Below Reorder Count =
CALCULATE(
    COUNTROWS(fact_Inventory),
    fact_Inventory[is_below_reorder] = TRUE()
)

Revenue At Risk (Stockouts) =
CALCULATE(
    SUM(fact_Inventory[revenue_at_risk]),
    fact_Inventory[stockout_flag] = TRUE()
)

Avg Days of Supply =
AVERAGE(fact_Inventory[days_of_supply])

Inventory Turnover =
// COGS / Avg Inventory Value — higher = leaner (industry benchmarks vary)
VAR _cogs     = [Total COGS]
VAR _avg_inv  = AVERAGEX(
    VALUES(dim_Date[Year]),
    CALCULATE(SUM(fact_Inventory[inventory_value]))
)
RETURN DIVIDE(_cogs, _avg_inv, 0)

Days Inventory Outstanding =
// 365 / Turnover — days to sell through average inventory
DIVIDE(365, [Inventory Turnover], BLANK())


// =============================================================================
// SECTION 7: SUPPLIER PERFORMANCE
// =============================================================================

Total POs =
COUNTROWS(fact_PurchaseOrders)

POs On Time =
CALCULATE(
    COUNTROWS(fact_PurchaseOrders),
    fact_PurchaseOrders[is_on_time] = TRUE()
)

Supplier On-Time Delivery % =
DIVIDE([POs On Time], [Total POs], 0)

Avg Supplier Lead Time (Actual) =
AVERAGEX(
    FILTER(fact_PurchaseOrders, NOT ISBLANK(fact_PurchaseOrders[actual_receipt_key])),
    DATEDIFF(
        RELATED_DATE_START,   // Replace with calculated column from Power Query: order_date
        RELATED_DATE_END,     // Replace with: actual_receipt_date
        DAY
    )
)
// NOTE: Computed via Power Query AddDaysToShip column; reference that column here:

Avg Lead Time Days =
AVERAGE(fact_PurchaseOrders[lead_time_days_actual])  // Column added in Power Query

Total Defects =
SUM(fact_PurchaseOrders[quality_reject_qty])

Defect Rate % =
DIVIDE(
    [Total Defects],
    SUM(fact_PurchaseOrders[quantity_received]),
    0
)

Supplier Spend =
SUM(fact_PurchaseOrders[total_cost])

Supplier Reliability Score (Avg) =
AVERAGE(dim_Suppliers[reliability_score])


// =============================================================================
// SECTION 8: DYNAMIC P&L TABLE MEASURE (for matrix visual)
// =============================================================================

P&L Amount =
// Master measure that drives the entire P&L matrix visual
// Rows = dim_Accounts[pl_line], Columns = fiscal periods
// Handles revenue (positive) and cost (negative) sign convention
VAR _is_revenue = SELECTEDVALUE(dim_Accounts[account_type]) = "Revenue"
VAR _raw        = SUM(fact_GL_Entries[amount_usd])
RETURN IF(_is_revenue, _raw, -_raw)

P&L Budget =
VAR _is_revenue = SELECTEDVALUE(dim_Accounts[account_type]) = "Revenue"
VAR _raw        = CALCULATE(
    SUM(fact_GL_Entries[amount_usd]),
    fact_GL_Entries[scenario] = "Budget"
)
RETURN IF(_is_revenue, _raw, -_raw)

P&L Variance =
[P&L Amount] - [P&L Budget]

P&L Variance % =
DIVIDE([P&L Variance], ABS([P&L Budget]), 0)

P&L Variance Color =
// Use in conditional formatting rule
IF([P&L Variance] >= 0, "#27AE60", "#E74C3C")

Running Total P&L =
// Cumulative P&L waterfall running sum (ordered by display_order)
CALCULATE(
    [P&L Amount],
    FILTER(
        ALL(dim_Accounts),
        dim_Accounts[display_order] <= MAX(dim_Accounts[display_order])
    )
)
